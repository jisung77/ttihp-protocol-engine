[tasks]
bank_a
bank_b

[options]
mode prove
timeout 240
aigsmt z3

[engines]
abc pdr

[script]
read_verilog -sv -formal -DPE_SIM_SRAM pe_fifo.v pe_core.v pe_host.v pe_sram.v project.v
expose tt_um_jisung_protocol_engine/w:pc_a tt_um_jisung_protocol_engine/w:pc_b tt_um_jisung_protocol_engine/w:dual_mode
expose tt_um_jisung_protocol_engine/w:exec_start_a tt_um_jisung_protocol_engine/w:exec_start_b tt_um_jisung_protocol_engine/w:retire_a tt_um_jisung_protocol_engine/w:retire_b
expose tt_um_jisung_protocol_engine/w:fetch_valid tt_um_jisung_protocol_engine/w:fetch_ctx tt_um_jisung_protocol_engine/w:sram_addr
bank_a: read_verilog -sv -formal pe_dual_bounds.sv
bank_b: read_verilog -sv -formal -DWATCH_B pe_dual_bounds.sv
hierarchy -check -top pe_dual_bounds
proc
select -assert-count 1 t:pe_sram
cutpoint t:pe_sram
select -assert-count 1 pe_host/w:words
select -assert-count 1 pe_host/w:checksum
cutpoint pe_host/w:words pe_host/w:checksum
prep -top pe_dual_bounds

[files]
../src/pe_fifo.v
../src/pe_core.v
../src/pe_host.v
../src/pe_sram.v
../src/project.v
pe_dual_bounds.sv
