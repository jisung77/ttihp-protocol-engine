[tasks]
safety default free_sram
bounds length
bounds_abstract length free_sram

[options]
mode prove
aigsmt z3
length: timeout 240

[engines]
abc pdr

[script]
read_verilog -sv -formal -DPE_SIM_SRAM pe_fifo.v pe_core.v pe_host.v pe_sram.v project.v
expose tt_um_jisung_protocol_engine/w:pc tt_um_jisung_protocol_engine/w:retire tt_um_jisung_protocol_engine/w:tx_count tt_um_jisung_protocol_engine/w:rx_count
safety: read_verilog -sv -formal pe_engine_formal.sv
length: read_verilog -sv -formal -DENGINE_LENGTH pe_engine_formal.sv
hierarchy -check -top pe_engine_formal
proc
# The concrete task keeps the full SRAM and loader. The fast proof permits
# arbitrary instruction words and independent write count and checksum values.
# Every concrete execution is included by taking its actual values at each edge.
select -assert-count 1 t:pe_sram
free_sram: cutpoint t:pe_sram
bounds_abstract: select -assert-count 1 pe_host/w:words
bounds_abstract: select -assert-count 1 pe_host/w:checksum
bounds_abstract: cutpoint pe_host/w:words pe_host/w:checksum
prep -top pe_engine_formal

[files]
../src/pe_fifo.v
../src/pe_core.v
../src/pe_host.v
../src/pe_sram.v
../src/project.v
pe_engine_formal.sv
